function treeNode(name,depth){
  const li=el('li');
  const n=resolve(name);
  const r=recMap[n];
  const node=el('span','tnode'+(isBase(n)?' baseleaf':''));
  const caret=el('span','caret',r&&!isBase(n)?'▸':'·');
  const d=el('span','dot '+(isBase(n)?'':dotClass(n)));
  if(isBase(n))d.style.background=BASECOLOR[n];
  node.append(caret,d,document.createTextNode(name));
  if(ALIAS[name.toLowerCase()])node.append(Object.assign(el('span','assume','→ '+ALIAS[name.toLowerCase()]+' (assumed)'),{}));
  li.append(node);
  if(r&&!isBase(n)){
    let open=false,ul=null;
    node.onclick=e=>{
      e.stopPropagation();
      if(!ul){
        ul=el('ul');
        ul.append(treeNode(r.i1,depth+1),treeNode(r.i2,depth+1));
        li.append(ul);
      }
      open=!open;ul.style.display=open?'':'none';caret.textContent=open?'▾':'▸';
    };
