/* ---------------- workbench (quantities + locks + queue + focus + favorites) ---------------- */
const bench=new Map(); // name -> count
const lockedSet=new Set(); // July update: previously-locked plating/laser were removed; plague got a new recipe — re-lock anything still gated via Lock mode
let lockMode=false;
const queue=[];
let focusTarget=null;      // one target whose materials are reserved
let allocated=new Map();   // name -> reserved count (derived each render)
const favs=['shark','blade','hammer','meteor'];

const qget=(m,k)=>m.get(k)||0;
const qadd=(m,k,d)=>{const v=qget(m,k)+d; v>0?m.set(k,v):m.delete(k)};
const isLocked=n=>lockedSet.has(n.toLowerCase());
function recipesFor(r){
  const out=[[r.i1.toLowerCase(),r.i2.toLowerCase()]];
  if(r.alt){const p=r.alt.split('+').map(s=>s.trim().toLowerCase());if(p.length===2)out.push(p)}
  return out;
}
function pairUsable(a,b){return !isLocked(a)&&!isLocked(b)}
function affordablePair(r,m){
  if(r.broken||isLocked(r.element))return undefined;
  return recipesFor(r).find(([a,b])=>pairUsable(a,b)&&(a===b?qget(m,a)>=2:(qget(m,a)>=1&&qget(m,b)>=1)));
}
function maxCrafts(r,m){
  if(r.broken||isLocked(r.element))return 0;
  let best=0;
  recipesFor(r).forEach(([a,b])=>{
    if(!pairUsable(a,b))return;
    const k=a===b?Math.floor(qget(m,a)/2):Math.min(qget(m,a),qget(m,b));
    if(k>best)best=k;
  });
  return best;
}
function craftOnce(r,m){
  const p=affordablePair(r,m);if(!p)return false;
  qadd(m,p[0],-1);qadd(m,p[1],-1);qadd(m,r.element.toLowerCase(),1);
  return true;
}
function planFor(name,m,steps,missing){
  const n=name.toLowerCase();
  if(!isLocked(n)&&qget(m,n)>=1){qadd(m,n,-1);return}
  const r=recMap[n];
  if(!r||r.broken||isLocked(n)){qadd(missing,n,1);return}
  const trials=recipesFor(r).map(pair=>{
    const tm=new Map(m),ts=[],tmiss=new Map(missing);
    planFor2(pair,r,tm,ts,tmiss);
    let cnt=0;tmiss.forEach(v=>cnt+=v);
    return {pair,tm,ts,tmiss,cnt};
  });
  trials.sort((a,b)=>a.cnt-b.cnt||a.ts.length-b.ts.length);
  const best=trials[0];
  m.clear();best.tm.forEach((v,k)=>m.set(k,v));
  missing.clear();best.tmiss.forEach((v,k)=>missing.set(k,v));
  best.ts.forEach(s=>steps.push(s));
}
function planFor2(pair,r,m,steps,missing){
  planFor(pair[0],m,steps,missing);
  planFor(pair[1],m,steps,missing);
  steps.push({element:r.element,pair});
}
function buildPlanQtyOn(target,baseMap){
  const m=new Map(baseMap),steps=[],missing=new Map();
  planFor(target,m,steps,missing);
  return {steps,missing,leftover:m,feasible:missing.size===0};
}
/* allocation: reserve everything the focus plan consumes from the real bench */
function computeAllocation(){
  allocated=new Map();
  if(!focusTarget)return;
  if(!queue.includes(focusTarget)){focusTarget=null;return}
  const plan=buildPlanQtyOn(focusTarget,bench);
  bench.forEach((v,k)=>{
    const used=v-qget(plan.leftover,k);
    if(used>0)allocated.set(k,used);
  });
}
function availableBench(){
  const m=new Map(bench);
  allocated.forEach((v,k)=>qadd(m,k,-v));
  return m;
}
// general-purpose plan = against UNRESERVED materials
function buildPlanQty(target){return buildPlanQtyOn(target,availableBench())}
function missTotal(missing){let c=0;missing.forEach(v=>c+=v);return c}
function missText(missing){
  return [...missing.entries()].sort((a,b)=>b[1]-a[1])
    .map(([k,v])=>(isLocked(k)?'🔒':'')+v+'× '+k+(recMap[k]&&recMap[k].broken?' (recipe unknown)':'')).join(', ');
}
function planBlocked(plan){
  return [...plan.missing.keys()].some(k=>isLocked(k)||(recMap[k]&&recMap[k].broken));
}

/* -------- annotated path tree -------- */
function annotatedTree(name,m){
  const n=name.toLowerCase();
  if(isLocked(n))return {name:n,status:'locked',children:[]};
  if(qget(m,n)>=1){qadd(m,n,-1);return {name:n,status:'have',children:[]}}
  const r=recMap[n];
  if(!r||r.broken)return {name:n,status:'missing',children:[],broken:!!(r&&r.broken)};
  const trials=recipesFor(r).map(pair=>{
    const tm=new Map(m),tmiss=new Map(),ts=[];
    planFor2(pair,r,tm,ts,tmiss);
    let cnt=0;tmiss.forEach(v=>cnt+=v);
    return {pair,cnt};
  });
  trials.sort((a,b)=>a.cnt-b.cnt);
  const pair=trials[0].pair;
  const kids=[annotatedTree(pair[0],m),annotatedTree(pair[1],m)];
  return {name:n,status:'craft',children:kids};
}
function nameSpan(node_name,nav){
  const nm=el('span','ptname'+(nav?' navable':''),recMap[node_name]?recMap[node_name].element:node_name);
  if(nav)nm.onclick=e=>{e.stopPropagation();nav(node_name)};
  return nm;
}
function renderPathNode(node,nav){
  const li=el('li');
  const span=el('span','tnode pt-'+node.status);
  const mark=el('span','ptmark',node.status==='have'?'✓':node.status==='craft'?'⚒':node.status==='locked'?'🔒':'✗');
  const d=el('span','dot '+(isBase(node.name)?'':dotClass(node.name)));
  if(isBase(node.name))d.style.background=BASECOLOR[node.name];
  span.append(mark,d,nameSpan(node.name,nav));
  if(node.broken)span.append(document.createTextNode(' '),el('span','brokenbadge','RECIPE UNKNOWN'));
  li.append(span);
  if(node.children.length){
    const ul=el('ul');
    node.children.forEach(c=>ul.append(renderPathNode(c,nav)));
    li.append(ul);
  }
  return li;
}

/* -------- forward tree -------- */
function consumersOf(name){
  const n=name.toLowerCase();
  const out=[];
  recipes.forEach(r=>{
    for(const pair of recipesFor(r)){
      if(pair[0]===n||pair[1]===n){
        out.push({r,partner:pair[0]===n?pair[1]:pair[0]});
        break;
      }
    }
  });
  return out;
}
const FW_DEPTH=2, FW_CAP=6;
function forwardBranch(name,depth,seen,nav,baseMap){
  const ul=el('ul');
  const n=name.toLowerCase();
  const cons=consumersOf(n)
    .filter(c=>!seen.has(c.r.element.toLowerCase()))
    .sort((a,b)=>(tierOf(a.r.element)??99)-(tierOf(b.r.element)??99));
  cons.slice(0,FW_CAP).forEach(({r,partner})=>{
    const cn=r.element.toLowerCase();
    seen.add(cn);
    const li=el('li');
    const locked=isLocked(cn),broken=!!r.broken;
    const span=el('span','tnode '+(locked?'pt-locked':broken?'pt-missing':'pt-craft'));
    const mark=el('span','ptmark',locked?'🔒':broken?'✗':'⟶');
    const d=el('span','dot '+dotClass(cn));
    span.append(mark,d,nameSpan(cn,nav));
    const haveP=!isLocked(partner)&&qget(baseMap,partner)>=1;
    span.append(el('span','fw-partner'+(haveP?' haveit':''),'  + '+partner+(haveP?' ✓':'')));
    if(broken)span.append(document.createTextNode(' '),el('span','brokenbadge','RECIPE UNKNOWN'));
    li.append(span);
    if(depth<FW_DEPTH&&!locked&&!broken){
      const child=forwardBranch(cn,depth+1,seen,nav,baseMap);
      li.append(child);
    }
    ul.append(li);
  });
  if(cons.length>FW_CAP){
    const li=el('li');
    li.append(el('span','fw-more','+ '+(cons.length-FW_CAP)+' more — click a node to explore, or see the Explorer tab'));
    ul.append(li);
  }
  return ul;
}

/* -------- navigable path panel -------- */
function buildPathPanel(targetName,opts){
  opts=opts||{};
  const baseMap=opts.baseMap||availableBench();
  const panel=el('div','pathpanel');
  const history=[];
  function render(root){
    panel.innerHTML='';
    // breadcrumb
    const crumb=el('div','ptcrumb');
    if(history.length){
      const back=el('button','ptback','◂ '+(recMap[history[history.length-1]]?recMap[history[history.length-1]].element:history[history.length-1]));
      back.onclick=e=>{e.stopPropagation();render(history.pop())};
      crumb.append(back);
    }
    crumb.append(el('span','ptroot',(recMap[root.toLowerCase()]?recMap[root.toLowerCase()].element:root).toUpperCase()));
    panel.append(crumb);
    const nav=next=>{
      if(next.toLowerCase()===root.toLowerCase())return;
      history.push(root.toLowerCase());
      if(opts.onNav)opts.onNav();
      render(next);
    };
    panel.append(el('div','ptlegend','PATH TO BUILD — ✓ on bench · ⚒ craft en route · ✗ need · 🔒 locked · click any name to re-root'));
    const tree=el('div','tree');
    const ul=el('ul');ul.style.cssText='border-left:none;padding-left:0;margin-left:0';
    ul.append(renderPathNode(annotatedTree(root,new Map(baseMap)),nav));
    tree.append(ul);panel.append(tree);

    panel.append(el('div','ptdivider'));
    const n=root.toLowerCase();
    const cons=consumersOf(n);
    if(cons.length){
      panel.append(el('div','ptlegend','OPENS UP — recipes this feeds into (+ partner, ✓ if available)'));
      const ftree=el('div','tree');
      const rootUl=el('ul');rootUl.style.cssText='border-left:none;padding-left:0;margin-left:0';
      const rootLi=el('li');
      const span=el('span','tnode pt-have');
      const d=el('span','dot '+(isBase(n)?'':dotClass(n)));
      if(isBase(n))d.style.background=BASECOLOR[n];
      span.append(el('span','ptmark','◆'),d,el('span','ptname',recMap[n]?recMap[n].element:root));
      rootLi.append(span);
      rootLi.append(forwardBranch(n,1,new Set([n]),nav,baseMap));
      rootUl.append(rootLi);ftree.append(rootUl);panel.append(ftree);
    } else {
      panel.append(el('div','ptlegend','OPENS UP — nothing yet'));
      panel.append(el('p','muted','No known recipe consumes this — a frontier element. Experiment in-game and log discoveries in Add Recipe.'));
    }
  }
  render(targetName);
  return panel;
}
function wrapWithPath(row,targetName,baseMap){
  const wrap=el('div','pathwrap');
  wrap.append(row);
  let built=false,pinned=false;
  const ensure=()=>{
    if(!built){
      wrap.append(buildPathPanel(targetName,{baseMap,onNav:()=>{pinned=true;wrap.classList.add('open')}}));
      built=true;
    }
  };
  wrap.onmouseenter=()=>{ensure();wrap.classList.add('open')};
  wrap.onmouseleave=()=>{if(!pinned)wrap.classList.remove('open')};
  row.addEventListener('click',e=>{
    if(e.target.closest('.craftbtn')||e.target.closest('.res')||e.target.closest('.starbtn')||e.target.closest('.focusbtn'))return;
    ensure();pinned=!pinned;
    wrap.classList.toggle('open',pinned);
  });
  return wrap;
}

/* -------- queue + focus -------- */
function queueAdd(name){
  const n=name.toLowerCase();
  if(!queue.includes(n))queue.push(n);
  renderStock();
}
function starBtn(name){
  const b=el('button','starbtn',queue.includes(name.toLowerCase())?'★':'☆');
  b.title='Append to target queue';
  b.onclick=e=>{e.stopPropagation();queueAdd(name)};
  return b;
}
function setFocus(n){
  focusTarget=focusTarget===n?null:n;
  renderStock();
}

function addToBench(n){qadd(bench,n.toLowerCase(),1);renderStock()}

function paletteChip(name){
  const b=isBase(name);
  const locked=isLocked(name);
  const c=document.createElement('span');
  c.className='chip'+(b?' base':'')+(locked?' locked':'');
  const d=document.createElement('span');d.className='dot '+(b?'':dotClass(name));
  if(b)d.style.background=BASECOLOR[name.toLowerCase()];
  c.append(d,document.createTextNode((locked?'🔒 ':'')+name),upgradeMarker(name));
  const q=qget(bench,name.toLowerCase());
  if(q)c.append(el('span','qty','×'+q));
  c.draggable=!locked&&!lockMode;
  c.ondragstart=e=>{e.dataTransfer.setData('text/plain',name);c.classList.add('dragging')};
  c.ondragend=()=>c.classList.remove('dragging');
  c.onclick=()=>{
    if(lockMode){
      const k=name.toLowerCase();
      lockedSet.has(k)?lockedSet.delete(k):lockedSet.add(k);
      renderStock();
    } else if(!locked){addToBench(name)}
  };
  if(locked&&!lockMode)c.title='Locked — turn on Lock mode to unlock';
  return c;
}
function benchChip(name,count){
  const b=isBase(name);
  const c=document.createElement('span');
  c.className='chip have'+(b?' base':'')+(isLocked(name)?' locked':'');
  const d=document.createElement('span');d.className='dot '+(b?'':dotClass(name));
  if(b)d.style.background=BASECOLOR[name.toLowerCase()];
  const minus=el('button','qbtn','−');minus.onclick=e=>{e.stopPropagation();qadd(bench,name,-1);renderStock()};
  const plus=el('button','qbtn','+');plus.onclick=e=>{e.stopPropagation();qadd(bench,name,1);renderStock()};
  c.append(d,document.createTextNode((isLocked(name)?'🔒 ':'')+name),el('span','qty','×'+count));
  const rsv=qget(allocated,name);
  if(rsv)c.append(el('span','rsv','⛶'+rsv));
  c.append(minus,plus);
  if(rsv)c.title=rsv+' reserved for focus: '+focusTarget;
  else if(isLocked(name))c.title='Locked — held copies are unusable until unlocked';
  return c;
}

/* -------- favorites bar -------- */
function renderFavs(){
  const fl=document.getElementById('favlist');if(!fl)return;
  fl.innerHTML='';
  favs.forEach(n=>{
    const known=recMap[n]||BASE.includes(n);
    const item=el('div','favitem');
    const d=el('span','dot '+(isBase(n)?'':known?dotClass(n):'tierdot-x'));
    if(isBase(n))d.style.background=BASECOLOR[n];
    const nm=el('span','fname',recMap[n]?recMap[n].element:n);
    item.append(d,nm);
    if(known){
      const plan=buildPlanQty(n);
      let st;
      if(qget(availableBench(),n)>=1&&!isLocked(n))st=el('span','favstat qstatus-ok','held');
      else if(isLocked(n))st=el('span','favstat qstatus-blocked','🔒');
      else if(plan.feasible)st=el('span','favstat qstatus-ok','✓'+plan.steps.length);
      else if(planBlocked(plan))st=el('span','favstat qstatus-blocked','⛔');
      else st=el('span','favstat qstatus-short',missTotal(plan.missing)+' short');
      item.append(st);
    }
    const x=el('button','favx','✕');
    x.onclick=e=>{e.stopPropagation();favs.splice(favs.indexOf(n),1);renderFavs()};
    item.append(x);
    item.title='Tap to append to target queue';
    item.onclick=()=>{
      queueAdd(n);
      const wb=document.querySelector('[data-tab=stock]');if(wb)wb.click();
    };
    fl.append(item);
  });
  if(!favs.length)fl.append(el('p','muted','No favorites yet.'));
}

function renderStock(){
  computeAllocation();
  const avail=availableBench();

  // focus banner
  const fb=document.getElementById('focusbanner');
  if(focusTarget){
    fb.style.display='';fb.innerHTML='';
    const band=el('div','focusband');
    let rtotal=0;allocated.forEach(v=>rtotal+=v);
    band.append(el('span',null,'◎ Focusing:'),el('span','fx',recMap[focusTarget]?recMap[focusTarget].element:focusTarget),
      el('span','muted','· '+rtotal+' item'+(rtotal===1?'':'s')+' reserved — everything below plans around them'));
    const rel=el('button','focusbtn','Release');
    rel.onclick=()=>{focusTarget=null;renderStock()};
    band.append(rel);
    fb.append(band);
  } else {fb.style.display='none';fb.innerHTML=''}

  // bench
  const bc=document.getElementById('benchchips');bc.innerHTML='';
  [...bench.entries()].sort((a,b)=>(tierOf(a[0])??(isBase(a[0])?0:99))-(tierOf(b[0])??(isBase(b[0])?0:99))||a[0].localeCompare(b[0]))
    .forEach(([n,q])=>bc.append(benchChip(n,q)));
  document.getElementById('benchhint').style.display=bench.size?'none':'flex';
  let total=0;bench.forEach(v=>total+=v);
  document.getElementById('owncount').textContent=total+' item'+(total===1?'':'s')+' · '+bench.size+' distinct';
  document.getElementById('lockcount').textContent=lockedSet.size+' locked';
  const lm=document.getElementById('lockmode');
  lm.textContent='🔒 Lock mode: '+(lockMode?'ON — tap chips to toggle':'off');
  lm.classList.toggle('lockmode-on',lockMode);

  // palette
  const q=(document.getElementById('stockq').value||'').trim().toLowerCase();
  const pmode=document.getElementById('palgroup').value;
  const grid=document.getElementById('stockgrid');grid.innerHTML='';
  if(pmode==='affinity'){
    const groups={};AFF_ORDER.forEach(a=>groups[a]=[]);
    BASE.forEach(b=>{if(!q||b.includes(q))groups[b].push(b)});
    [...recipes].sort((a,b)=>(tierOf(a.element)??99)-(tierOf(b.element)??99)||a.element.localeCompare(b.element)).forEach(r=>{
      if(q&&!r.element.toLowerCase().includes(q))return;
      groups[affinityOf(r.element).dom].push(r.element);
    });
    AFF_ORDER.forEach(a=>{
      if(!groups[a].length)return;
      const g=el('div','tiergroup');
      g.append(affHeader(a,groups[a].length));
      const tc=el('div','tchips');
      groups[a].forEach(n=>tc.append(paletteChip(n)));
      g.append(tc);grid.append(g);
    });
  } else {
    const groups={};
    BASE.forEach(b=>{if(!q||b.includes(q))(groups[0]=groups[0]||[]).push(b)});
    [...recipes].sort((a,b)=>a.element.localeCompare(b.element)).forEach(r=>{
      if(q&&!r.element.toLowerCase().includes(q))return;
      const t=tierOf(r.element)??'?';
      (groups[t]=groups[t]||[]).push(r.element);
    });
    Object.keys(groups).sort((a,b)=>(a==='?')-(b==='?')||a-b).forEach(k=>{
      const g=el('div','tiergroup');
      g.append(el('div','tlabel',k==='0'?'BASE ELEMENTS':k==='?'?'UNRESOLVED TIER':'TIER '+k));
      const tc=el('div','tchips');
      groups[k].forEach(n=>tc.append(paletteChip(n)));
      g.append(tc);grid.append(g);
    });
  }

  // queue select
  const qs=document.getElementById('queuesel');const cur=qs.value;
  qs.innerHTML='<option value="">— pick a target to append —</option>';
  [...recipes].sort((a,b)=>a.element.localeCompare(b.element)).forEach(r=>{
    const o=document.createElement('option');o.value=r.element;o.textContent=r.element;qs.append(o);
  });
  qs.value=cur;

  // queue — focused row plans on FULL bench; others on available
  const ql=document.getElementById('queuelist');ql.innerHTML='';
  const qitems=queue.map(n=>{
    const focused=n===focusTarget;
    const plan=focused?buildPlanQtyOn(n,bench):buildPlanQty(n);
    const blocked=planBlocked(plan);
    return {n,focused,plan,blocked,
      rank:focused?[-1,0]:plan.feasible?[0,plan.steps.length]:blocked?[2,missTotal(plan.missing)]:[1,missTotal(plan.missing)]};
  }).sort((a,b)=>a.rank[0]-b.rank[0]||a.rank[1]-b.rank[1]);
  qitems.forEach(({n,focused,plan,blocked})=>{
    const r=recMap[n];const disp=r?r.element:n;
    const row=el('div','craftrow');
    const d=el('span','dot '+dotClass(n));d.style.cssText='width:8px;height:8px;border-radius:50%;display:inline-block';
    const res=el('span','res',disp);res.onclick=()=>{document.querySelector('[data-tab=explore]').click();showDetail(disp)};
    row.append(d,res);
    const fbtn=el('button','focusbtn'+(focused?' on':''),focused?'◎ Focused':'◎ Focus');
    fbtn.title=focused?'Release reserved materials':'Reserve bench materials for this build';
    fbtn.onclick=e=>{e.stopPropagation();setFocus(n)};
    row.append(fbtn);
    if(qget(bench,n)>=1&&!isLocked(n)){row.append(el('span','badge qstatus-ok','ON BENCH ×'+qget(bench,n)))}
    else if(plan.feasible){
      row.append(el('span','badge qstatus-ok','✓ buildable · '+plan.steps.length+' combines'));
      const btn=el('button','craftbtn','Build chain ▸');
      btn.onclick=()=>{
        const fresh=buildPlanQtyOn(n,bench); // building the focus (or any) target spends real bench
        if(!fresh.feasible){renderStock();return}
        bench.clear();fresh.leftover.forEach((v,k)=>bench.set(k,v));
        qadd(bench,n,1);
        if(focusTarget===n)focusTarget=null;
        renderStock();
      };
      row.append(btn);
    } else if(blocked){
      row.append(el('span','badge qstatus-blocked','⛔ blocked'),el('span','needlist',missText(plan.missing)));
    } else {
      row.append(el('span','badge qstatus-short',missTotal(plan.missing)+' short'),el('span','needlist','need '+missText(plan.missing)));
    }
    const rm=el('button','starbtn','✕');rm.title='Remove from queue';
    rm.onclick=e=>{e.stopPropagation();queue.splice(queue.indexOf(n),1);if(focusTarget===n)focusTarget=null;renderStock()};
    row.append(rm);
    ql.append(wrapWithPath(row,n,focused?bench:avail));
  });
  if(!queue.length)ql.append(el('p','muted','Queue is empty — append targets above, tap ☆ on any row below, or tap a favorite in the side bar.'));

  // craftable now (on available materials)
  const now=document.getElementById('craftnow');now.innerHTML='';
  const nowList=recipes.filter(r=>maxCrafts(r,avail)>0)
    .sort((a,b)=>(tierOf(a.element)??99)-(tierOf(b.element)??99)||a.element.localeCompare(b.element));
  nowList.forEach(r=>{
    const pair=affordablePair(r,avail);
    const row=el('div','craftrow');
    row.append(chip(pair[0],{small:true}),el('span','eq','+'),chip(pair[1],{small:true}),el('span','eq','='));
    const res=el('span','res',r.element);res.onclick=()=>{document.querySelector('[data-tab=explore]').click();showDetail(r.element)};
    const d=el('span','dot '+dotClass(r.element));d.style.cssText='width:8px;height:8px;border-radius:50%;display:inline-block';
    row.append(d,res,el('span','badge','×'+maxCrafts(r,avail)+' possible'),starBtn(r.element));
    const btn=el('button','craftbtn','Craft 1 ▸');
    btn.onclick=()=>{craftOnce(r,bench);renderStock()};
    row.append(btn);
    now.append(row);
  });
  if(!nowList.length)now.append(el('p','muted',bench.size?(focusTarget?'Nothing affordable with unreserved materials — release focus to free them up.':'The bench can’t pay for any single combine — doubles need two copies, and locked elements don’t count.'):'The bench is empty — drop elements in.'));

  // within reach
  const reach=document.getElementById('reachable');reach.innerHTML='';
  const directSet=new Set(nowList.map(r=>r.element.toLowerCase()));
  const reachList=recipes
    .filter(r=>!r.broken&&!isLocked(r.element)&&!directSet.has(r.element.toLowerCase()))
    .map(r=>({r,plan:buildPlanQty(r.element)}))
    .filter(x=>x.plan.feasible&&x.plan.steps.length>1)
    .sort((a,b)=>a.plan.steps.length-b.plan.steps.length||(tierOf(a.r.element)??99)-(tierOf(b.r.element)??99));
  reachList.slice(0,30).forEach(({r,plan})=>{
    const row=el('div','craftrow');
    const d=el('span','dot '+dotClass(r.element));d.style.cssText='width:8px;height:8px;border-radius:50%;display:inline-block';
    const res=el('span','res',r.element);res.onclick=()=>{document.querySelector('[data-tab=explore]').click();showDetail(r.element)};
    row.append(d,res,el('span','badge','tier '+(tierOf(r.element)??'?')),el('span','badge',plan.steps.length+' combines'),starBtn(r.element));
    const btn=el('button','craftbtn','Build chain ▸');
    btn.onclick=()=>{
      const fresh=buildPlanQty(r.element);
      if(!fresh.feasible){renderStock();return}
      // spend from real bench: available leftover + reserved portion
      const newBench=new Map(fresh.leftover);
      allocated.forEach((v,k)=>qadd(newBench,k,v));
      bench.clear();newBench.forEach((v,k)=>bench.set(k,v));
      qadd(bench,r.element.toLowerCase(),1);
      renderStock();
    };
    row.append(btn);
    reach.append(wrapWithPath(row,r.element,avail));
  });
  if(!reachList.length)reach.append(el('p','muted',bench.size?'No multi-step chains affordable with unreserved materials.':'Drop elements in to see chain options.'));
  if(reachList.length>30)reach.append(el('p','muted','Showing 30 of '+reachList.length+'.'));

  // building towards
  const dl=document.getElementById('distlist');dl.innerHTML='';
  const targets=recipes
    .filter(r=>!r.broken&&!isLocked(r.element)&&(tierOf(r.element)??0)>=3)
    .map(r=>({r,plan:buildPlanQty(r.element)}))
    .filter(x=>!x.plan.feasible)
    .sort((a,b)=>missTotal(a.plan.missing)-missTotal(b.plan.missing)||(tierOf(b.r.element)??0)-(tierOf(a.r.element)??0))
    .slice(0,14);
  targets.forEach(({r,plan})=>{
    const row=el('div','distrow');
    row.append(el('span','n',missTotal(plan.missing)+' short'));
    row.append(chip(r.element,{small:true}));
    row.append(el('span','needlist','need '+missText(plan.missing)));
    row.append(starBtn(r.element));
    dl.append(wrapWithPath(row,r.element,avail));
  });
  if(!targets.length)dl.append(el('p','muted',bench.size?'Every unlocked tier 3+ target is affordable from unreserved materials. Stacked.':'Drop elements in to see shopping lists.'));

  renderFavs();
}

// drag & drop wiring
const benchEl=document.getElementById('bench');
benchEl.ondragover=e=>{e.preventDefault();benchEl.classList.add('dragover')};
benchEl.ondragleave=()=>benchEl.classList.remove('dragover');
benchEl.ondrop=e=>{
  e.preventDefault();benchEl.classList.remove('dragover');
  const n=e.dataTransfer.getData('text/plain');
  if(n&&!isLocked(n))addToBench(n);
};
document.getElementById('stockq').oninput=renderStock;
document.getElementById('palgroup').onchange=renderStock;
document.getElementById('stock-clear').onclick=()=>{bench.clear();focusTarget=null;renderStock()};
document.getElementById('lockmode').onclick=()=>{lockMode=!lockMode;renderStock()};
document.getElementById('queueadd').onclick=()=>{
  const v=document.getElementById('queuesel').value;
  if(v)queueAdd(v);
};
document.getElementById('queueclear').onclick=()=>{queue.length=0;focusTarget=null;renderStock()};
document.getElementById('stock-import').onclick=()=>{
  const txt=document.getElementById('stockpaste').value;
  let misses=[];
  txt.split(/[,\n;]+/).map(s=>s.trim().toLowerCase()).filter(Boolean).forEach(tok=>{
    const m=tok.match(/^(.+?)(?:\s*[x×]\s*(\d+))?$/);
    if(!m)return;
    const n=m[1].trim(),k=m[2]?parseInt(m[2],10):1;
    if(recMap[n]||BASE.includes(n))qadd(bench,n,k);
    else misses.push(n);
  });
  document.getElementById('stockpaste').value=misses.length?('Not found: '+misses.join(', ')):'';
  renderStock();
};
document.getElementById('favaddbtn').onclick=()=>{
  const v=document.getElementById('favinput').value.trim().toLowerCase();
  if(!v)return;
  if(!recMap[v]&&!BASE.includes(v)){document.getElementById('favinput').value='not found';return}
  if(!favs.includes(v))favs.push(v);
  document.getElementById('favinput').value='';
  renderFavs();
};
/* ---------------- boot ---------------- */
function refreshAll(){
  document.getElementById('hs-el').textContent=recipes.length+4;
  document.getElementById('hs-rec').textContent=recipes.length+recipes.filter(r=>r.alt).length;
  const maxT=Math.max(...recipes.map(r=>tierOf(r.element)).filter(t=>t!=null));
  document.getElementById('hs-tier').textContent=maxT;
  const tf=document.getElementById('tierfilter');const cur=tf.value;
  tf.innerHTML='<option value="">All tiers</option><option value="0">Base</option>';
  for(let i=1;i<=maxT;i++){const o=document.createElement('option');o.value=i;o.textContent='Tier '+i;tf.append(o)}
  const o=document.createElement('option');o.value='?';o.textContent='Unresolved';tf.append(o);
  const oT=document.createElement('option');oT.value='T';oT.textContent='◆ Terminal / dead-end';tf.append(oT);
  const oU=document.createElement('option');oU.value='U';oU.textContent='› Has upgrades';tf.append(oU);
  tf.value=cur;
  renderGrid();fillPathSelect();renderDB();renderGuide();renderStock();
}
rebuild();refreshAll();
showDetail('laser');
</script>
</body>
</html>
