<script>
const RAW_RECIPES=[{"element":"blaze","i1":"fire","i2":"fire","alt":null,"tier":1},{"element":"dust","i1":"wind","i2":"earth","alt":null,"tier":1},{"element":"stone","i1":"earth","i2":"earth","alt":null,"tier":1},{"element":"metal","i1":"fire","i2":"earth","alt":null,"tier":1},{"element":"mud","i1":"water","i2":"earth","alt":null,"tier":1},{"element":"steam","i1":"fire","i2":"water","alt":null,"tier":1},{"element":"snow","i1":"wind","i2":"water","alt":null,"tier":1},{"element":"gust","i1":"wind","i2":"wind","alt":null,"tier":1},{"element":"drip","i1":"water","i2":"water","alt":null,"tier":1},{"element":"flame","i1":"fire","i2":"wind","alt":null,"tier":1},{"element":"whoosh","i1":"wind","i2":"gust","alt":null,"tier":1},{"element":"ice","i1":"water","i2":"snow","alt":null,"tier":1},{"element":"gunpowder","i1":"fire","i2":"dust","alt":null,"tier":1},{"element":"wave","i1":"water","i2":"gust","alt":null,"tier":1},{"element":"spike","i1":"earth","i2":"stone","alt":null,"tier":1},{"element":"sprout","i1":"water","i2":"mud","alt":null,"tier":1},{"element":"bacteria","i1":"water","i2":"dust","alt":null,"tier":1},{"element":"snowball","i1":"wind","i2":"snow","alt":null,"tier":1},{"element":"sand","i1":"earth","i2":"dust","alt":null,"tier":1},{"element":"glass","i1":"fire","i2":"sand","alt":null,"tier":1},{"element":"spire","i1":"fire","i2":"spike","alt":null,"tier":1},{"element":"mist","i1":"fire","i2":"ice","alt":null,"tier":1},{"element":"vine","i1":"drip","i2":"sprout","alt":null,"tier":2},{"element":"twister","i1":"gust","i2":"whoosh","alt":null,"tier":2},{"element":"stonewall","i1":"stone","i2":"mud","alt":null,"tier":2},{"element":"brick","i1":"blaze","i2":"mud","alt":"flame+mud","tier":2},{"element":"cloud","i1":"steam","i2":"mist","alt":"gust+mist","tier":2},{"element":"fireball","i1":"blaze","i2":"blaze","alt":null,"tier":2},{"element":"quake","i1":"spike","i2":"wave","alt":null,"tier":2},{"element":"wall","i1":"mud","i2":"brick","alt":null,"tier":2},{"element":"waterfall","i1":"drip","i2":"drip","alt":null,"tier":2},{"element":"inferno","i1":"flame","i2":"fireball","alt":null,"tier":2},{"element":"sea","i1":"drip","i2":"waterfall","alt":null,"tier":2},{"element":"time","i1":"sand","i2":"glass","alt":null,"tier":2},{"element":"spikefield","i1":"spike","i2":"spike","alt":null,"tier":2},{"element":"shotgun","i1":"metal","i2":"gunpowder","alt":null,"tier":2},{"element":"plague","i1":"wind","i2":"bacteria","alt":null,"tier":2},{"element":"lava","i1":"blaze","i2":"stone","alt":null,"tier":2},{"element":"anvil","i1":"metal","i2":"metal","alt":null,"tier":2},{"element":"geyser","i1":"spike","i2":"steam","alt":null,"tier":2},{"element":"desert","i1":"sand","i2":"gust","alt":"sand+dust","tier":2},{"element":"icicle","i1":"ice","i2":"spike","alt":null,"tier":2},{"element":"boulder","i1":"stone","i2":"stone","alt":null,"tier":2},{"element":"bottle","i1":"blaze","i2":"glass","alt":null,"tier":2},{"element":"avalanche","i1":"snowball","i2":"snowball","alt":null,"tier":2},{"element":"blade","i1":"metal","i2":"whoosh","alt":null,"tier":2},{"element":"wood","i1":"water","i2":"vine","alt":null,"tier":2},{"element":"lightning","i1":"metal","i2":"cloud","alt":null,"tier":2},{"element":"obsidian","i1":"drip","i2":"lava","alt":null,"tier":2},{"element":"arrow","i1":"spike","i2":"vine","alt":null,"tier":2},{"element":"rain","i1":"cloud","i2":"drip","alt":null,"tier":2},{"element":"chain","i1":"metal","i2":"vine","alt":null,"tier":2},{"element":"bomb","i1":"gunpowder","i2":"brick","alt":null,"tier":2},{"element":"snowfall","i1":"snow","i2":"rain","alt":null,"tier":2},{"element":"firewall","i1":"flame","i2":"wall","alt":null,"tier":2},{"element":"sun","i1":"stone","i2":"inferno","alt":null,"tier":2},{"element":"island","i1":"earth","i2":"sea","alt":null,"tier":2},{"element":"molotov","i1":"bottle","i2":"fireball","alt":null,"tier":3},{"element":"sword","i1":"anvil","i2":"blade","alt":null,"tier":3},{"element":"storm","i1":"rain","i2":"lightning","alt":null,"tier":3},{"element":"fort","i1":"wall","i2":"wall","alt":null,"tier":3},{"element":"zap","i1":"chain","i2":"lightning","alt":null,"tier":3},{"element":"hammer","i1":"wood","i2":"anvil","alt":null,"tier":3},{"element":"landmine","i1":"spikefield","i2":"bomb","alt":null,"tier":3},{"element":"logs","i1":"wood","i2":"wood","alt":null,"tier":3},{"element":"meteor","i1":"boulder","i2":"fireball","alt":null,"tier":3},{"element":"vortex","i1":"tornado","i2":"sea","alt":null,"tier":3},{"element":"iceberg","i1":"icicle","i2":"sea","alt":null,"tier":3},{"element":"hellfire","i1":"inferno","i2":"fireball","alt":null,"tier":3},{"element":"tsunami","i1":"quake","i2":"sea","alt":null,"tier":3},{"element":"volcano","i1":"lava","i2":"geyser","alt":null,"tier":3},{"element":"shark","i1":"sea","i2":"fireball","alt":null,"tier":3},{"element":"tornado","i1":"twister","i2":"storm","alt":null,"tier":3},{"element":"katana","i1":"whoosh","i2":"sword","alt":null,"tier":3},{"element":"Excalibur","i1":"stone","i2":"sword","alt":null,"tier":3,"broken":true},{"element":"crater","i1":"earth","i2":"meteor","alt":null,"tier":3,"broken":true},{"element":"firenado","i1":"hellfire","i2":"tornado","alt":null,"tier":4},{"element":"warhammer","i1":"hammer","i2":"hammer","alt":null,"tier":4},{"element":"zapstorm","i1":"zap","i2":"storm","alt":null,"tier":4},{"element":"Mjolnir","i1":"warhammer","i2":"zapstorm","alt":null,"tier":5}];

/* ---------------- model ---------------- */
const BASE=['fire','water','earth','wind'];
const BASECOLOR={fire:'var(--fire)',water:'var(--water)',earth:'var(--earth)',wind:'var(--wind)'};
// known typo aliases in the source data — used for tree/path resolution, flagged in UI
const ALIAS={}; // v1.4: all ingredients resolve, no aliases needed
let recipes=RAW_RECIPES.map(r=>({...r,element:r.element.trim(),added:false}));
let recMap,tiers,usedIn;

function rebuild(){
  affMemo={};
  recMap={};recipes.forEach(r=>recMap[r.element.toLowerCase()]=r);
  tiers={};BASE.forEach(b=>tiers[b]=0);
  // v1.4: the game declares official tiers; use them directly.
  recipes.forEach(r=>{tiers[r.element.toLowerCase()]=(typeof r.tier==='number')?r.tier:null});
  usedIn={};
  recipes.forEach(r=>{
    [r.i1,r.i2].forEach(i=>{
      const k=(ALIAS[i.toLowerCase()]||i.toLowerCase());
      (usedIn[k]=usedIn[k]||[]).push(r.element);
    });
    if(r.alt){r.alt.split('+').map(s=>s.trim().toLowerCase()).forEach(i=>{
      const k=ALIAS[i]||i;(usedIn[k]=usedIn[k]||[]).push(r.element+' (alt)');
    });}
  });
}
function tierOf(name){const n=ALIAS[name.toLowerCase()]||name.toLowerCase();return n in tiers?tiers[n]:null}
function isBase(n){return BASE.includes(n.toLowerCase())}
function resolve(name){const n=name.toLowerCase();return ALIAS[n]||n}

// deps: set of unique non-base elements needed (min steps), topological order
function buildPlan(target){
  const order=[],seen=new Set(),missing=new Set();
  const visit=(name,stack)=>{
    const n=resolve(name);
    if(isBase(n)||seen.has(n))return;
    if(stack.has(n))return;
    const r=recMap[n];
    if(!r){missing.add(name);return}
    stack.add(n);
    visit(r.i1,stack);visit(r.i2,stack);
    stack.delete(n);
    seen.add(n);order.push(r);
  };
  visit(target,new Set());
  return {order,missing:[...missing]};
}


/* ---------------- affinity & lineage ---------------- */
let affMemo={};
function baseComp(name,stack){
  const n=name.toLowerCase();
  if(BASE.includes(n)){const c={};c[n]=1;return c}
  if(affMemo[n])return affMemo[n];
  stack=stack||new Set();
  if(stack.has(n))return {};
  const r=recMap[n];if(!r)return {};
  stack.add(n);
  const a=baseComp(r.i1,stack),b=baseComp(r.i2,stack);
  stack.delete(n);
  const c={};
  [a,b].forEach(x=>Object.entries(x).forEach(([k,v])=>c[k]=(c[k]||0)+v));
  affMemo[n]=c;return c;
}
function affinityOf(name){
  const n=name.toLowerCase();
  if(BASE.includes(n))return {dom:n,share:1};
  const c=baseComp(n);
  const tot=Object.values(c).reduce((a,b)=>a+b,0)||1;
  const sorted=Object.entries(c).sort((a,b)=>b[1]-a[1]);
  if(!sorted.length)return {dom:'hybrid',share:0};
  const [top,second]=[sorted[0],sorted[1]];
  if((!second||top[1]>second[1])&&top[1]/tot>=0.5)return {dom:top[0],share:top[1]/tot};
  return {dom:'hybrid',share:top[1]/tot};
}
// lineage parent: the ingredient carrying the element's dominant base; hybrids -> higher-tier ingredient
function parentOf(r){
  const pair=[r.i1.toLowerCase(),r.i2.toLowerCase()];
  const aff=affinityOf(r.element);
  if(aff.dom!=='hybrid'){
    const carrier=pair.filter(p=>{
      if(BASE.includes(p))return p===aff.dom;
      return affinityOf(p).dom===aff.dom;
    });
    if(carrier.length===1)return carrier[0];
    if(carrier.length===2){ // both carry it — pick higher tier, tie -> first
      const t=p=>BASE.includes(p)?0:(tierOf(p)??0);
      return t(carrier[0])>=t(carrier[1])?carrier[0]:carrier[1];
    }
  }
  const t=p=>BASE.includes(p)?0:(tierOf(p)??0);
  return t(pair[0])>=t(pair[1])?pair[0]:pair[1];
}
function lineageForest(){
  const kids={};BASE.forEach(b=>kids[b]=[]);
  recipes.forEach(r=>{
    const p=parentOf(r);
    (kids[p]=kids[p]||[]).push(r.element.toLowerCase());
  });
  Object.values(kids).forEach(arr=>arr.sort((a,b)=>(tierOf(a)??99)-(tierOf(b)??99)||a.localeCompare(b)));
  return kids;
}
const AFF_ORDER=['fire','water','earth','wind','hybrid'];
const AFF_COLOR={fire:'var(--fire)',water:'var(--water)',earth:'var(--earth)',wind:'var(--wind)',hybrid:'var(--ember)'};

/* ---------------- shared UI bits ---------------- */
function dotClass(name){
  const t=tierOf(name);
  return t==null?'tierdot-x':'tierdot-'+t;
}
function upgradeMarker(name){
  // › N = feeds N working recipes · ◆ = terminal (no known upgrades) · red ◆ = only broken upgrades
  const cons=consumersOf(name);
  const usable=cons.filter(c=>!c.r.broken).length;
  if(usable>0){
    const m=el('span','upmark','›'+usable);
    m.title='Feeds '+usable+' recipe'+(usable===1?'':'s')+' — has further upgrades';
    return m;
  }
  const m=el('span','endmark'+(cons.length?' deadend':''),'◆');
  m.title=cons.length?'Dead end for now — its only upgrade uses a broken recipe':'Terminal element — nothing crafts from this yet. Prime for experimentation.';
  return m;
}
function chip(name,{small=false,meta=false}={}){
  const b=isBase(name);
  const c=document.createElement('span');
  c.className='chip'+(b?' base':'')+(small?' sm':'');
  const d=document.createElement('span');d.className='dot '+(b?'':dotClass(name));
  if(b)d.style.background=BASECOLOR[name.toLowerCase()];
  c.append(d,document.createTextNode(name));
  if(meta)c.append(upgradeMarker(name));
  if(!b&&recMap[resolve(name)]){c.onclick=()=>showDetail(recMap[resolve(name)].element)}
  else if(b){c.style.cursor='default'}
  return c;
}
const el=(t,cls,txt)=>{const e=document.createElement(t);if(cls)e.className=cls;if(txt!=null)e.textContent=txt;return e};

/* ---------------- tabs ---------------- */
document.getElementById('legendbtn').onclick=function(){
  const lg=document.getElementById('legend');
  const on=lg.style.display==='none';
  lg.style.display=on?'':'none';
  this.classList.toggle('on',on);
};
document.querySelectorAll('nav button').forEach(b=>{if(b.id==='legendbtn')return;b.onclick=()=>{
  document.querySelectorAll('nav button').forEach(x=>x.classList.remove('on'));
  document.querySelectorAll('.tab').forEach(x=>x.classList.remove('on'));
  b.classList.add('on');
  document.getElementById('tab-'+b.dataset.tab).classList.add('on');
}});

/* ---------------- explorer ---------------- */
function affHeader(dom,count){
  const w=el('div','tlabel');
  const lab=el('span','afflabel');
  const d=el('span','dot');d.style.background=AFF_COLOR[dom];
  lab.append(d,document.createTextNode(dom.toUpperCase()+' AFFINITY — '+count+' element'+(count===1?'':'s')));
  w.append(lab);
  return w;
}
function passesFilters(r,q,tf){
  if(q&&!(r.element.toLowerCase().includes(q)||r.i1.toLowerCase().includes(q)||r.i2.toLowerCase().includes(q)))return false;
  if(tf==='T'||tf==='U'){
    const usable=consumersOf(r.element).filter(c=>!c.r.broken).length;
    if(tf==='T'&&usable>0)return false;
    if(tf==='U'&&usable===0)return false;
  } else if(tf!==''){
    const key=tierOf(r.element)==null?'?':String(tierOf(r.element));
    if(key!==tf)return false;
  }
  return true;
}
function metaChip(n){
  const c=chip(n,{meta:true});
  if(recMap[n.toLowerCase()]&&recMap[n.toLowerCase()].added)c.append(Object.assign(el('span','newtag','NEW'),{style:'margin-left:4px'}));
  return c;
}
function renderGrid(){
  const q=document.getElementById('q').value.trim().toLowerCase();
  const tf=document.getElementById('tierfilter').value;
  const mode=document.getElementById('groupby').value;
  const grid=document.getElementById('grid');grid.innerHTML='';

  if(mode==='tree'){renderLineageTree(grid,q,tf);return}

  if(mode==='affinity'){
    const groups={};AFF_ORDER.forEach(a=>groups[a]=[]);
    [...recipes].sort((a,b)=>(tierOf(a.element)??99)-(tierOf(b.element)??99)||a.element.localeCompare(b.element)).forEach(r=>{
      if(!passesFilters(r,q,tf))return;
      groups[affinityOf(r.element).dom].push(r.element);
    });
    let any=false;
    AFF_ORDER.forEach(a=>{
      if(!groups[a].length)return;
      any=true;
      const g=el('div','tiergroup');
      g.append(affHeader(a,groups[a].length));
      const tc=el('div','tchips');
      groups[a].forEach(n=>{
        const c=metaChip(n);
        const sh=Math.round(affinityOf(n).share*100);
        c.append(el('span','affshare',sh+'%'));
        tc.append(c);
      });
      g.append(tc);grid.append(g);
    });
    if(!any)grid.append(el('p','muted','No elements match — try a shorter search.'));
    return;
  }

  // tier mode (default)
  const groups={};
  const list=[...recipes].sort((a,b)=>a.element.localeCompare(b.element));
  if(!q&&tf==='')groups[0]=BASE.slice();
  list.forEach(r=>{
    if(!passesFilters(r,q,tf))return;
    const t=tierOf(r.element);
    const key=t==null?'?':t;
    (groups[key]=groups[key]||[]).push(r.element);
  });
  const keys=Object.keys(groups).sort((a,b)=>(a==='?')-(b==='?')||a-b);
  keys.forEach(k=>{
    const g=el('div','tiergroup');
    g.append(el('div','tlabel',k==='0'?'BASE ELEMENTS':k==='?'?'UNRESOLVED TIER':'TIER '+k));
    const tc=el('div','tchips');
    groups[k].forEach(n=>tc.append(metaChip(n)));
    g.append(tc);grid.append(g);
  });
  if(!keys.length)grid.append(el('p','muted','No elements match — try a shorter search.'));
}
function renderLineageTree(grid,q,tf){
  const kids=lineageForest();
  // match set: elements passing filters; keep ancestors of matches
  const matches=new Set();
  recipes.forEach(r=>{if(passesFilters(r,q,tf))matches.add(r.element.toLowerCase())});
  const filtering=!!q||tf!=='';
  const visible=new Set(matches);
  if(filtering){
    // walk up: parent chain
    const par={};recipes.forEach(r=>par[r.element.toLowerCase()]=parentOf(r));
    matches.forEach(m=>{
      let p=par[m];
      while(p&&!BASE.includes(p)){visible.add(p);p=par[p]}
    });
  }
  const tree=el('div','ltree');
  const rootUl=el('ul');
  const hint=el('p','muted','Lineage tree — each element sits under the ingredient that carries its dominant affinity (hybrids under their higher-tier ingredient). Click carets to expand, chips to inspect.');
  grid.append(hint);
  BASE.forEach(b=>{
    const li=buildLineageNode(b,kids,visible,filtering,0);
    if(li)rootUl.append(li);
  });
  tree.append(rootUl);grid.append(tree);
  if(filtering&&!matches.size)grid.append(el('p','muted','No elements match.'));
}
function buildLineageNode(name,kids,visible,filtering,depth){
  const n=name.toLowerCase();
  const childNames=(kids[n]||[]).filter(c=>!filtering||visible.has(c));
  const isRoot=BASE.includes(n);
  if(filtering&&!isRoot&&!visible.has(n))return null;
  if(filtering&&isRoot&&!childNames.length)return null;
  const li=el('li');
  const line=el('span');
  const caret=el('span','lnodecaret'+(childNames.length?'':' leaf'),childNames.length?'▸':'·');
  line.append(caret);
  const c=chip(recMap[n]?recMap[n].element:n,{meta:!isRoot});
  line.append(c);
  if(childNames.length)line.append(el('span','affshare',childNames.length+' branch'+(childNames.length===1?'':'es')));
  li.append(line);
  if(childNames.length){
    let ul=null,open=filtering||depth<1; // roots open by default; everything open while filtering
    const toggle=()=>{
      if(!ul){
        ul=el('ul');
        childNames.forEach(cn=>{const node=buildLineageNode(cn,kids,visible,filtering,depth+1);if(node)ul.append(node)});
        li.append(ul);
      }
      open=!open;
      ul.style.display=open?'':'none';
      caret.textContent=open?'▾':'▸';
    };
    caret.onclick=toggle;
    if(open){open=false;toggle()}
  }
  return li;
}
document.getElementById('q').oninput=renderGrid;
document.getElementById('groupby').onchange=renderGrid;
